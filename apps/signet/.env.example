# Required by the hosted checker. Every value must be independently generated.
CTF_EVENT_GENERATION=ctf26-2026-final
FLAG_SECRET=
CHALLENGE_TICKET_SECRET=
CHALLENGE_SESSION_SECRET=
LEADERBOARD_INGEST_URL=https://portal.example.org/api/leaderboard/events

# Choose one Redis transport. Railway provides REDIS_URL; Vercel commonly uses REST credentials.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Private RPC used only by the server-side checker. Never prefix this with NEXT_PUBLIC_/VITE_.
SOLANA_RPC_URL=

# Optional rehearsal fallback. Production normally loads per-participant targets from Redis.
SIGNET_TARGETS_JSON=

# Optional explorer configuration exposed to the player interface.
SOLANA_EXPLORER_CLUSTER=custom
PUBLIC_SOLANA_RPC_URL=

# Bounded checker and public health-probe capacity.
SIGNET_SUBMIT_LIMIT_PER_MINUTE=12
SIGNET_TARGET_LIMIT_PER_MINUTE=30
SIGNET_GLOBAL_SUBMIT_LIMIT_PER_MINUTE=240
SIGNET_GLOBAL_TARGET_LIMIT_PER_MINUTE=600
# Invalid launches are isolated in these pre-authentication attempt buckets.
SIGNET_SESSION_ATTEMPT_LIMIT_PER_IP_PER_MINUTE=120
SIGNET_GLOBAL_SESSION_ATTEMPT_LIMIT_PER_MINUTE=5000
# Only cryptographically valid launch tickets consume these admission buckets.
SIGNET_SESSION_LIMIT_PER_MINUTE=240
SIGNET_PARTICIPANT_SESSION_LIMIT_PER_MINUTE=12
SIGNET_MAX_CONCURRENCY=8
SIGNET_SUBMIT_LEASE_SECONDS=60
SIGNET_HEALTH_CACHE_MS=15000
SIGNET_MIN_OPERATOR_LAMPORTS=100000000
SIGNET_PROVISION_FEE_BUFFER_LAMPORTS=150000

# Provisioning-only inputs (keep INSTANCE_SECRET out of the browser service where possible).
# Publish fresh targets for every CTF_EVENT_GENERATION. Never reuse rehearsal targets in a scored event.
INSTANCE_SECRET=
SIGNET_OPERATOR_KEYPAIR_JSON=
OPERATOR_KEYPAIR=.keys/signet-operator.json
VAULT_PROGRAM_ID=
PARTICIPANT_ID=
SOLANA_CLUSTER=devnet
 # Internal rehearsal only. Keep false (or unset) for the live event.
ALLOW_DIRECT_TEST_ACCESS=false
