{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/signet/Dockerfile.railway",
    "watchPatterns": [
      "apps/signet/**",
      "packages/participant-ticket/**",
      "packages/leaderboard/**",
      "packages/agent-integrity/**",
      "packages/request-budget/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
