CENTRAL_BASE_URL=http://localhost:3001
CENTRAL_SESSION_SECRET=
PARTICIPANT_ID_SECRET=
CHALLENGE_TICKET_SECRET_REWARD_SNIPER=
CHALLENGE_TICKET_SECRET_IMPRINT=
CHALLENGE_TICKET_SECRET_SIGNET=
CHALLENGE_TICKET_SECRET_DRIFT=
CHALLENGE_TICKET_SECRET_LAST_STOP=
CHALLENGE_TICKET_SECRET_AFTER_HOURS=
CHALLENGE_TICKET_SECRET_PLAYER_TWO=
CHALLENGE_TICKET_SECRET_THE_BROADCAST=
CHALLENGE_TICKET_SECRET_EVIDENCE_ROOM=
CHALLENGE_TICKET_SECRET_SECOND_KEY=
CHALLENGE_TICKET_SECRET_THE_CHAMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_DEV_LOGIN=false
# Keep false for the event. Set true only for an explicitly open production staging environment.
ALLOW_OPEN_REGISTRATION=false
# JSON array of {"email":"...","displayName":"..."}. Participant IDs are derived by the portal.
# Required for event production.
PARTICIPANT_ROSTER_JSON=
# Comma-separated Google accounts allowed to open the organizer dashboard.
# Keep at least two distinct accounts so event operations do not depend on one login.
CTF_ADMIN_EMAILS=

# Live leaderboard. Set field size to the actual event-day check-in count before scoring starts.
LEADERBOARD_FIELD_SIZE=50
LEADERBOARD_REGISTERED_COUNT=50
# Keep both values at zero while the award policy is unpublished. Set the final values explicitly
# before official scoring. Every participant with a positive score receives the configured floor.
LEADERBOARD_MIN_INDIVIDUAL_AWARD_USD=0
LEADERBOARD_PRIZE_POOL_USD=0
# Switch to live only after setting the final roster, checked-in field, and UTC scoring window.
LEADERBOARD_SCORING_MODE=staging
# Emergency deployment-level gate. This stops new challenge sessions without changing the immutable event window.
LEADERBOARD_LAUNCH_PAUSED=false
# Required in production only while deliberately running a rehearsal deployment in staging mode.
ALLOW_STAGING_SCORING=false
LEADERBOARD_SCORING_START_AT=
LEADERBOARD_SCORING_END_AT=
# Immutable label for one event run. Required in live, recovery, freezing, and frozen modes.
# This must exactly match CTF_EVENT_GENERATION on every challenge service.
LEADERBOARD_EVENT_GENERATION=ctf26-2026-final
# Copy the Reward Sniper event ID from its health endpoint after the final market is created.
REWARD_SNIPER_EVENT_ID=
# Copy the Reward Sniper scoringConfigHash from the same health response. Official scoring rejects drift.
REWARD_SNIPER_SCORING_CONFIG_HASH=
# JSON array. Optional only when every rostered participant is checked in.
LEADERBOARD_CHECKED_IN_PARTICIPANT_IDS=
# Signed retries and authoritative recovery close this many minutes after scoring ends.
LEADERBOARD_RECOVERY_MINUTES=30
# Shared Redis used for live solve state. REDIS_URL may use Railway's public TLS URL on Vercel.
REDIS_URL=
# Redis REST is also supported when TCP is unavailable.
KV_REST_API_URL=
KV_REST_API_TOKEN=

REWARD_SNIPER_URL=http://localhost:3010/web/
REWARD_SNIPER_ADMIN_URL=http://localhost:3010
REWARD_SNIPER_ADMIN_KEY=
# Shared with Reward Sniper's INTEGRITY_INGEST_KEY. Falls back to the admin key only during migration.
INTEGRITY_INGEST_KEY=
# A completion inside this many seconds of the participant's first launch creates a manual-review signal only.
FAST_SOLVE_REVIEW_SECONDS=300
# Maximum time for the portal readiness check to wait on any challenge dependency.
PORTAL_DEPENDENCY_TIMEOUT_MS=4000
# Shared in-process readiness cache. Keep short so health remains useful without fanning out on every probe.
PORTAL_HEALTH_CACHE_MS=15000
IMPRINT_URL=http://localhost:3002
SIGNET_URL=
DRIFT_URL=
LAST_STOP_URL=http://localhost:3005/launch
AFTER_HOURS_URL=http://localhost:3006/launch
PLAYER_TWO_URL=http://localhost:3007/
THE_BROADCAST_URL=http://localhost:3008/launch
EVIDENCE_ROOM_URL=http://localhost:3009
SECOND_KEY_URL=http://localhost:3011
THE_CHAMBER_URL=http://localhost:3012
