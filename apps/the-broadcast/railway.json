{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/the-broadcast/Dockerfile",
    "watchPatterns": ["apps/the-broadcast/**", "packages/participant-ticket/**", "packages/leaderboard/**", "packages/agent-integrity/**", "packages/request-budget/**"]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
