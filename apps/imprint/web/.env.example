# Operator-selected devnet RPC for the hosted console.
# This is not a player requirement; solvers can use any working devnet RPC in their own scripts.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=D1UH7XaF9PLCfDngD1X5T8ihzQf84E6KykJyDG5V1jUk
NEXT_PUBLIC_VAULT_ID=target-vault-001
IMPRINT_EXPECTED_ORIGIN=https://imprint.example.org
IMPRINT_RP_ID=imprint.example.org

# Optional for a pre-seeded event/devnet target.
# NEXT_PUBLIC_TARGET_AUTHORITY=
# NEXT_PUBLIC_TARGET_VAULT=
# Production authenticator policy (leave unset for localhost development):
# IMPRINT_REQUIRE_ATTESTATION=true
# IMPRINT_REQUIRE_DEVICE_BOUND_PASSKEY=true
# IMPRINT_ALLOWED_AAGUIDS=00000000-0000-0000-0000-000000000000

# Server-only. Use a dedicated registrar wallet for production/Vercel.
# REGISTRAR_KEYPAIR_JSON=[...]
# REGISTRAR_KEYPAIR_PATH=/absolute/path/to/keypair.json
