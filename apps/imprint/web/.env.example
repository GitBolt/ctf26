# The RPC endpoint stays server-side. Browser requests use the same-origin API relay.
SOLANA_RPC_URL=https://your-private-devnet-rpc.example
# Public player-console configuration. Assigned target addresses come from the authenticated session.
NEXT_PUBLIC_PROGRAM_ID=<fresh-v2-program-id>

# Must exactly match the portal LEADERBOARD_EVENT_GENERATION for this event run.
CTF_EVENT_GENERATION=ctf26-2026-final
# Durable, atomic launch-ticket replay protection. Production never falls back to memory.
REDIS_URL=rediss://default:<password>@<host>:<port>
IMPRINT_REDIS_PREFIX=ctf26:imprint:ticket:v1
IMPRINT_STATE_REDIS_PREFIX=ctf26:imprint:state:v2

# Production WebAuthn relying-party configuration.
IMPRINT_EXPECTED_ORIGIN=https://imprint.example.org
IMPRINT_RP_ID=imprint.example.org

# Server-only challenge access and scoring secrets. Generate distinct values of at least 32 bytes.
CHALLENGE_TICKET_SECRET=<same-as-portal-CHALLENGE_TICKET_SECRET_IMPRINT>
LEADERBOARD_INGEST_URL=https://portal.example.org/api/leaderboard/events
IMPRINT_SESSION_SECRET=<random-32-byte-secret>
IMPRINT_FLAG_SECRET=<random-32-byte-secret>
# Shared first-party integrity collector. The key is server-only and identical across hosted challenges.
INTEGRITY_INGEST_URL=https://reward-sniper.example/api/internal/integrity/disclosure
INTEGRITY_INGEST_KEY=<shared-random-32-byte-secret>

# Server-only registrar. Use a dedicated registrar key for the fresh program deployment.
REGISTRAR_KEYPAIR_JSON=[...]
# REGISTRAR_KEYPAIR_PATH=/absolute/path/to/keypair.json

# First launch creates one platform passkey and one funded vault for the
# authenticated participant. The same participant ID always derives the same
# vault, so retries and refreshes are safe.
IMPRINT_INSTANCE_SECRET=<random-32-byte-secret>
IMPRINT_OPERATOR_KEYPAIR_JSON=[...]
IMPRINT_TARGET_INITIAL_LAMPORTS=10000000
IMPRINT_TARGET_MINIMUM_DRAIN_LAMPORTS=5000000
IMPRINT_MIN_OPERATOR_LAMPORTS=100000000
# Optional comma-separated platform-authenticator AAGUID allowlist.
# IMPRINT_ENROLLMENT_ALLOWED_AAGUIDS=<approved-platform-aaguids>
