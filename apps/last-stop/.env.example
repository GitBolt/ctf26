PORT=3005
CTF_EVENT_GENERATION=ctf26-2026-final
SSH_PORT=2222
LAST_STOP_PUBLIC_ORIGIN=https://last-stop.example.org
LAST_STOP_SSH_HOST=ssh.last-stop.example.org
LAST_STOP_SSH_PUBLIC_PORT=2222
LAST_STOP_SSH_HOST_KEY_BASE64=replace-with-base64-encoded-openssh-private-key
# Alternatively, mount a secret file and set LAST_STOP_SSH_HOST_KEY_PATH=/run/secrets/ssh_host_ed25519_key
LAST_STOP_SSH_GLOBAL_AUTH_RATE_MAX=1200
LAST_STOP_SSH_CODE_AUTH_RATE_MAX=8
LAST_STOP_MAX_ACTIVE_SSH_CONNECTIONS=100
LAST_STOP_SSH_AUTH_TIMEOUT_MS=20000
CHALLENGE_TICKET_SECRET=replace-with-at-least-32-bytes
LAST_STOP_TICKET_AUDIENCE=last-stop
LEADERBOARD_INGEST_URL=https://portal.example.org/api/leaderboard/events
INTEGRITY_INGEST_URL=https://reward-sniper.example/api/internal/integrity/disclosure
INTEGRITY_INGEST_KEY=replace-with-the-shared-32-byte-integrity-ingest-secret
LAST_STOP_FLAG_SECRET=replace-with-at-least-32-bytes
LAST_STOP_SESSION_MAX_MS=300000
LAST_STOP_LAUNCH_RATE_MAX=4
LAST_STOP_VALIDATOR_RATE_MAX=120
LAST_STOP_MAX_ACTIVE_VALIDATORS=24
REDIS_URL=
LAST_STOP_REDIS_PREFIX=last-stop:v1
# Railway supplies RAILWAY_TCP_PROXY_DOMAIN and RAILWAY_TCP_PROXY_PORT.
