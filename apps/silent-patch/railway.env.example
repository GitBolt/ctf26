# Railway service runtime. Reference REDIS_URL from the attached Redis service.
NODE_ENV=production
HOST=0.0.0.0
REDIS_URL=${{Redis.REDIS_URL}}

# Generate each secret independently with at least 32 random bytes.
FLAG_SECRET=
CHALLENGE_TICKET_SECRET=
CHALLENGE_SESSION_SECRET=
INTEGRITY_INGEST_URL=https://reward-sniper.example/api/internal/integrity/disclosure
INTEGRITY_INGEST_KEY=

# Private devnet RPC for finalized checker reads.
SOLANA_RPC_URL=
SOLANA_EXPLORER_CLUSTER=devnet
PUBLIC_SOLANA_RPC_URL=

# Optional rehearsal-only fallback; omit when targets are stored in Redis.
SIGNET_TARGETS_JSON=
