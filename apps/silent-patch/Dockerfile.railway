FROM node:22-alpine AS production

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080

WORKDIR /workspace/apps/silent-patch

# The local participant-ticket dependency must keep the repository-relative path.
COPY --chown=node:node packages/participant-ticket /workspace/packages/participant-ticket
COPY --chown=node:node packages/agent-integrity /workspace/packages/agent-integrity
COPY --chown=node:node apps/silent-patch/package.json apps/silent-patch/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY --chown=node:node apps/silent-patch/public ./public
COPY --chown=node:node apps/silent-patch/repo ./repo
COPY --chown=node:node apps/silent-patch/scripts ./scripts
COPY --chown=node:node apps/silent-patch/src ./src
COPY --chown=node:node apps/silent-patch/starter ./starter

RUN npm run build

USER node
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=12s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "src/server.mjs"]
