{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/the-chamber/Dockerfile",
    "watchPatterns": [
      "apps/the-chamber/**",
      "packages/participant-ticket/**",
      "packages/leaderboard/**",
      "packages/agent-integrity/**",
      "packages/request-budget/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
