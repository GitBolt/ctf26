PORT=3012
CTF_EVENT_GENERATION=ctf26-2026-final

# Issued by the portal as CHALLENGE_TICKET_SECRET_THE_CHAMBER; this service
# receives only its own value. It also authenticates the private completion
# contract and signs solve reports.
PARTICIPANT_TICKET_SECRET=replace-with-the-portal-the-chamber-ticket-secret
SESSION_SECRET=replace-with-at-least-32-bytes
COMPLETION_SECRET=replace-with-at-least-32-bytes
AGENT_POLICY_SECRET=replace-with-at-least-32-bytes

# The prototype program is already deployed to devnet. ADMIN_KEY and HIDDEN_KEY
# are compiled into its bytecode, so a fresh run must deploy a fresh program and
# use challenge-scoped keys held outside the repository.
THE_CHAMBER_PROGRAM_ID=ZWXmHNvUZ4bVe4cUQJtt7VheafuNc7G2kr7us1PTJUc
THE_CHAMBER_ADMIN_KEYPAIR=[devnet-admin-keypair-json]
# Public-archive mode only: Base64 of the retired 64-byte venue-card keypair.
# Keep it in the deployment secret manager. Never enable this during a scored run.
THE_CHAMBER_PUBLIC_CARD_BASE64=
THE_CHAMBER_NETWORK=devnet
SOLANA_RPC_URL=https://your-private-devnet-rpc.example

# Capacity is derived from the live payer balance. The admin pays rent plus fees
# for one User PDA per participant, and portal readiness compares the resulting
# maximum with the checked-in field.
THE_CHAMBER_RENT_LAMPORTS=2408160
THE_CHAMBER_FEE_BUDGET_LAMPORTS=10000

THE_CHAMBER_PREAUTH_IP_LIMIT_PER_MINUTE=240
THE_CHAMBER_PREAUTH_GLOBAL_LIMIT_PER_MINUTE=2400
THE_CHAMBER_SESSION_LIMIT_PER_MINUTE=240
THE_CHAMBER_PARTICIPANT_OPERATION_LIMIT_PER_MINUTE=30
THE_CHAMBER_GLOBAL_OPERATION_LIMIT_PER_MINUTE=1200
THE_CHAMBER_MAX_EXPENSIVE_CONCURRENCY=1
THE_CHAMBER_MAX_READ_CONCURRENCY=12
THE_CHAMBER_OPERATION_TIMEOUT_MS=40000
THE_CHAMBER_OPERATION_LEASE_MS=60000
THE_CHAMBER_HEALTH_CACHE_MS=15000

LEADERBOARD_INGEST_URL=https://portal.example/api/leaderboard/events
INTEGRITY_INGEST_URL=https://reward-sniper.example/api/internal/integrity/disclosure
INTEGRITY_INGEST_KEY=replace-with-the-shared-32-byte-integrity-ingest-secret

REDIS_URL=
THE_CHAMBER_REDIS_PREFIX=the-chamber:v1
ALLOW_DEV_LAUNCH=false
