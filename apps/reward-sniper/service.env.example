NODE_ENV=production
# Use staging for rehearsals. Official mode requires a scheduled start and the exact checked-in roster.
REWARD_EVENT_MODE=staging
# Internal rehearsal only. Keep false (or unset) for the live event.
ALLOW_DIRECT_TEST_ACCESS=false
# Required only when ALLOW_DIRECT_TEST_ACCESS=true. Never embed this in client source.
DIRECT_TEST_ACCESS_KEY=
HOST=0.0.0.0
PORT=3010
COMMIT_MS=20000
REVEAL_MS=10000
ROUND_TICKS=12
PRACTICE_ROUNDS=1
# Must be at least 2 so the qualification threshold is achievable.
SCORED_ROUNDS=3
# Staging rehearsals may start on the first participant session. Keep EVENT_START_AT empty in this mode.
START_ON_FIRST_SESSION=true
# Event day: set START_ON_FIRST_SESSION=false and provide synchronized ISO-8601 start and end times.
# EVENT_START_AT=2026-07-25T10:00:00+05:30
# Required in official mode. Keep this identical to the portal LEADERBOARD_SCORING_END_AT.
# EVENT_END_AT=2026-07-25T13:00:00+05:30
# Required in official mode. Use the exact portal checked-in participant IDs.
# REGISTERED_PARTICIPANT_IDS_JSON=["participant-one","participant-two"]
MARKET_SEED=replace-with-a-private-round-seed
STATE_FILE=/data/reward-sniper-state.json
# Must exactly match the portal LEADERBOARD_EVENT_GENERATION for this event run.
CTF_EVENT_GENERATION=ctf26-2026-final
# Atomic launch-ticket replay protection. Production never falls back to process memory or the volume.
REDIS_URL=redis://default:<password>@<host>:<port>
REWARD_SNIPER_REDIS_PREFIX=ctf26:reward-sniper:ticket:v1

# Each secret must contain at least 32 bytes. Store real values in the deployment secret manager.
PARTICIPANT_TICKET_SECRET=replace-with-the-same-secret-as-the-portal
SESSION_SECRET=replace-with-a-random-session-signing-secret
VOUCHER_SECRET=replace-with-a-random-voucher-signing-secret
INTEGRITY_ADMIN_KEY=replace-with-a-random-organizer-api-secret
INTEGRITY_INGEST_KEY=replace-with-a-shared-random-ingest-secret
# Optional Discord-compatible webhook mirror. The first-party admin console remains authoritative.
INTEGRITY_ALERT_WEBHOOK_URL=
