NODE_ENV=production
PORT=3020
CTF_EVENT_GENERATION=ctf26-2026-final

# Must match portal CHALLENGE_TICKET_SECRET_DRIFT.
CHALLENGE_TICKET_SECRET=<random-32-plus-byte-secret>
DRIFT_SESSION_SECRET=<independent-random-32-plus-byte-secret>
LEADERBOARD_INGEST_URL=https://portal.example.org/api/leaderboard/events
FLAG_SECRET=<independent-random-32-plus-byte-secret>
INTEGRITY_INGEST_URL=https://reward-sniper.example/api/internal/integrity/disclosure
INTEGRITY_INGEST_KEY=<shared-random-32-plus-byte-secret>

# Required for autoscaled/container hosting. Provides atomic one-time tickets and rate limits.
REDIS_URL=<managed-redis-connection-url>
DRIFT_REQUIRE_SHARED_STATE=true

DRIFT_TICKET_AUDIENCE=drift

DRIFT_REPLAY_LIMIT_PER_MINUTE=30
DRIFT_SUBMIT_LIMIT_PER_MINUTE=6
# Invalid launches are isolated in these pre-authentication attempt buckets.
DRIFT_SESSION_ATTEMPT_LIMIT_PER_IP_PER_MINUTE=120
DRIFT_GLOBAL_SESSION_ATTEMPT_LIMIT_PER_MINUTE=5000
# Only cryptographically valid launch tickets consume these admission buckets.
DRIFT_SESSION_LIMIT_PER_MINUTE=240
DRIFT_PARTICIPANT_SESSION_LIMIT_PER_MINUTE=12
DRIFT_GLOBAL_WORK_LIMIT_PER_MINUTE=240
DRIFT_MAX_CONCURRENCY=4
DRIFT_CHECKER_TIMEOUT_MS=15000
DRIFT_OPERATION_LEASE_MS=20000
DRIFT_HEALTH_CACHE_MS=15000
# Qualifying solves faster than this are reviewed only when at least one additional signal agrees.
DRIFT_RAPID_SOLVE_MS=900000

# Optional deployment overrides.
# DRIFT_CHECKER_PATH=/srv/drift/native/harness/target/release/drift-harness
# DRIFT_PROGRAM_PATH=/srv/drift/player-kit/dist/drift_vault.so
# DRIFT_PERSONALIZED_ARTIFACT_DIR=/tmp/ctf26-drift-artifacts
