{
  "name": "overclock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sbf": "node scripts/build-sbf.mjs",
    "build:checker": "cargo +stable build --release --manifest-path native/harness/Cargo.toml",
    "build": "npm run build:sbf && npm run build:checker",
    "test:model": "node --test",
    "test:native": "cargo +stable test --manifest-path native/harness/Cargo.toml",
    "test": "npm run build:sbf && npm run test:model && npm run test:native",
    "target": "cargo +stable run --quiet --manifest-path native/harness/Cargo.toml -- target",
    "demo": "cargo +stable run --quiet --manifest-path native/harness/Cargo.toml -- demo",
    "replay": "cargo +stable run --quiet --manifest-path native/harness/Cargo.toml -- replay",
    "check": "cargo +stable run --quiet --manifest-path native/harness/Cargo.toml -- check",
    "model": "node bin/overclock.mjs"
  }
}
